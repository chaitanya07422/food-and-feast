NODE_ENV=development
PORT=4000

# MongoDB — local, Atlas, or OCI-hosted
MONGODB_URI=mongodb://127.0.0.1:27017/food-and-feast

# Comma-separated browser origins (credentials / cookies)
CORS_ORIGIN=http://localhost:3000

# Behind nginx HTTPS set true (also auto-on when NODE_ENV=production)
TRUST_PROXY=false

# Long random string — required in production
SESSION_SECRET=change-me-to-a-long-random-string

# Admin login — synced into Mongo on every API boot
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeLocalOnly123!

# Public base used when saving image URLs (browsers must reach this)
# Local:  http://localhost:4000
# Prod:   https://your-domain.com
PUBLIC_API_ORIGIN=http://localhost:4000

# Storage: local (dev) or oci (Oracle production — same pattern as CreditSea LMS)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Required when STORAGE_DRIVER=oci
# OCI_NAMESPACE=your_namespace
# OCI_BUCKET=your-bucket
# OCI_REGION=ap-hyderabad-1
# OCI_CONFIG_FILE=/home/ubuntu/.oci/config
# OCI_PROFILE=DEFAULT
# OCI_KEY_PREFIX=food-and-feast
