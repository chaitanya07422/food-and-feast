# Local Mac demo — copy to .env and adjust if needed
NODE_ENV=development
PORT=4000

# Local MongoDB (Homebrew mongod default)
MONGODB_URI=mongodb://127.0.0.1:27017/food-and-feast

# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Session / cookie auth (Milestone 4). Generate a long random string for local use.
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin (used only by seed script — never hardcode in production)
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeLocalOnly123!

# Image uploads. Local disk for demo; Cloudinary/OCI later.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
# Used when building public image URLs returned to the admin UI
PUBLIC_API_ORIGIN=http://localhost:4000
